---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Daniel Uwandu — Software developer',
  description = 'Software developer based in Lagos, Nigeria. I work in C#, TypeScript, JavaScript, Go, C++, SQL and Solidity, building on ASP.NET Core and NestJS with SQL Server and PostgreSQL.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Daniel Uwandu',
  jobTitle: 'Software developer',
  address: { '@type': 'PostalAddress', addressLocality: 'Lagos', addressCountry: 'NG' },
  alumniOf: 'University of Lagos',
  url: 'https://idhaniel.github.io',
  sameAs: ['https://github.com/Idhaniel', 'https://linkedin.com/in/daniel-u-b79b78194'],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0c100e" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script is:inline>
      document.documentElement.classList.add('js');
      try { var t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
    </script>
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Daniel Uwandu, software developer in Lagos" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body>
    <slot />
    <script>
      import Lenis from 'lenis';
      import '../scripts/motion';
      // Smooth scroll, off when the visitor asks for reduced motion.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const lenis = new Lenis({ lerp: 0.1, anchors: true });
        const raf = (t: number) => { lenis.raf(t); requestAnimationFrame(raf); };
        requestAnimationFrame(raf);
      }
    </script>
  </body>
</html>
