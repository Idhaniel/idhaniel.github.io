---
// A faint network map drawn at build time: nodes, links to their nearest
// neighbours, and a few routes where a pulse hops link by link.
interface Props {
  seed?: number;
  class?: string;
}
const { seed = 7, class: className = '' } = Astro.props;

function rng(a: number) {
  return () => {
    a |= 0; a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rand = rng(seed);

const W = 1440, H = 900, COLS = 13, ROWS = 8;
type Node = { x: number; y: number; hub: boolean };
const nodes: Node[] = [];
for (let r = 0; r < ROWS; r++) {
  for (let c = 0; c < COLS; c++) {
    if (rand() < 0.3) continue;
    nodes.push({
      x: Math.round((c + 0.5 + (rand() - 0.5) * 0.8) * (W / COLS)),
      y: Math.round((r + 0.5 + (rand() - 0.5) * 0.8) * (H / ROWS)),
      hub: rand() < 0.12,
    });
  }
}

const key = (a: number, b: number) => (a < b ? `${a}-${b}` : `${b}-${a}`);
const edges = new Map<string, [number, number]>();
const adj: number[][] = nodes.map(() => []);
nodes.forEach((n, i) => {
  const near = nodes
    .map((m, j) => ({ j, d: (m.x - n.x) ** 2 + (m.y - n.y) ** 2 }))
    .filter((o) => o.j !== i)
    .sort((a, b) => a.d - b.d)
    .slice(0, n.hub ? 4 : 2);
  for (const { j } of near) {
    const k = key(i, j);
    if (!edges.has(k)) {
      edges.set(k, [i, j]);
      adj[i].push(j);
      adj[j].push(i);
    }
  }
});

// Routes: random walks that don't revisit a node.
const routes: [number, number][][] = [];
for (let r = 0; r < 5; r++) {
  let at = Math.floor(rand() * nodes.length);
  const seen = new Set([at]);
  const hops: [number, number][] = [];
  for (let s = 0; s < 6; s++) {
    const next = adj[at].filter((j) => !seen.has(j));
    if (!next.length) break;
    const to = next[Math.floor(rand() * next.length)];
    hops.push([at, to]);
    seen.add(to);
    at = to;
  }
  if (hops.length >= 3) routes.push(hops);
}
const routePaths = routes.map((hops) =>
  'M' + [hops[0][0], ...hops.map((h) => h[1])].map((i) => `${nodes[i].x} ${nodes[i].y}`).join(' L')
);
---
<svg
  class={`net ${className}`}
  viewBox={`0 0 ${W} ${H}`}
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
>
  <g class="net__links">
    {[...edges.values()].map(([a, b]) => (
      <line x1={nodes[a].x} y1={nodes[a].y} x2={nodes[b].x} y2={nodes[b].y} />
    ))}
  </g>
  <g class="net__pulses">
    {routes.map((hops, r) =>
      hops.map(([a, b], s) => (
        <line
          x1={nodes[a].x} y1={nodes[a].y} x2={nodes[b].x} y2={nodes[b].y}
          style={`--delay: ${(r * 1.7 + s * 0.35).toFixed(2)}s`}
        />
      ))
    )}
  </g>
  <g class="net__packets">
    {routePaths.map((d, r) => (
      <circle r="3" class={r % 2 ? 'amber' : ''}>
        <animateMotion path={d} dur={`${5 + (r % 3) * 1.5}s`} begin={`-${(r * 1.3).toFixed(1)}s`} repeatCount="indefinite" calcMode="linear" />
      </circle>
    ))}
  </g>
  <g class="net__cursor"><line /><line /><line /></g>
  <g class="net__nodes">
    {nodes.map((n) =>
      n.hub
        ? <rect x={n.x - 3.5} y={n.y - 3.5} width="7" height="7" rx="1.5" class="hub" data-x={n.x} data-y={n.y} />
        : <circle cx={n.x} cy={n.y} r="2" data-x={n.x} data-y={n.y} />
    )}
  </g>
</svg>

<script>
  // Nodes near the pointer light up and the pointer "joins" the network
  // with links to its three nearest nodes. Fine pointers only.
  if (matchMedia('(pointer: fine)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const nets = [...document.querySelectorAll<SVGSVGElement>('svg.net')];
    let px = 0, py = 0, queued = false;
    const update = () => {
      queued = false;
      for (const svg of nets) {
        const box = svg.getBoundingClientRect();
        if (box.bottom < 0 || box.top > innerHeight) continue;
        const m = svg.getScreenCTM();
        if (!m) continue;
        const pt = new DOMPoint(px, py).matrixTransform(m.inverse());
        const nodes = [...svg.querySelectorAll<SVGElement>('[data-x]')];
        const ranked = nodes
          .map((n) => ({ n, d: Math.hypot(+n.dataset.x! - pt.x, +n.dataset.y! - pt.y) }))
          .sort((a, b) => a.d - b.d);
        const inside = py >= box.top && py <= box.bottom;
        for (const { n, d } of ranked) n.classList.toggle('near', inside && d < 180);
        const links = svg.querySelectorAll<SVGLineElement>('.net__cursor line');
        links.forEach((l, i) => {
          const t = ranked[i];
          const on = inside && t && t.d < 260;
          l.style.opacity = on ? String(0.9 - i * 0.25) : '0';
          if (t) {
            l.setAttribute('x1', String(pt.x)); l.setAttribute('y1', String(pt.y));
            l.setAttribute('x2', t.n.dataset.x!); l.setAttribute('y2', t.n.dataset.y!);
          }
        });
      }
    };
    const onMove = (e: PointerEvent) => {
      px = e.clientX; py = e.clientY;
      if (!queued) { queued = true; requestAnimationFrame(update); }
    };
    addEventListener('pointermove', onMove, { passive: true });
    addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(update); } }, { passive: true });
  }
</script>

<style>
  .net {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .net__links line {
    stroke: var(--edge);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
    opacity: 0.7;
  }
  .net__nodes circle, .net__nodes .hub {
    transition: opacity var(--dur-ui) var(--ease), fill var(--dur-ui) var(--ease), stroke var(--dur-ui) var(--ease);
  }
  .net__nodes circle { fill: var(--ash); opacity: 0.5; }
  .net__nodes .hub { fill: none; stroke: var(--ash); stroke-width: 1; opacity: 0.7; vector-effect: non-scaling-stroke; }
  .net__nodes circle.near { fill: var(--accent); opacity: 1; }
  .net__nodes .hub.near { stroke: var(--accent); opacity: 1; }
  .net__pulses line {
    stroke: var(--accent);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
    opacity: 0;
  }
  .net__packets circle { fill: var(--accent); }
  .net__packets circle.amber { fill: var(--amber); }
  .net__cursor line {
    stroke: var(--accent);
    stroke-width: 1;
    stroke-dasharray: 3 4;
    vector-effect: non-scaling-stroke;
    opacity: 0;
    transition: opacity var(--dur-ui) var(--ease);
  }
  @media (prefers-reduced-motion: reduce) {
    .net__packets { display: none; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .net__pulses line { animation: hop 9s var(--ease) infinite; animation-delay: var(--delay); }
  }
  /* Each link lights briefly, one after the next, like a packet on a route. */
  @keyframes hop {
    0%, 100% { opacity: 0; }
    3% { opacity: 0.8; }
    9% { opacity: 0; }
  }
</style>
