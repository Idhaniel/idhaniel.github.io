---
import { Image } from 'astro:assets';
import NetworkBackdrop from './NetworkBackdrop.astro';
import ThemeToggle from './ThemeToggle.astro';
import photo from '../assets/daniel.jpg';

const email = 'danieluwanduc@gmail.com';
const first = 'Daniel'.split('');
const last = 'Uwandu'.split('');
---
<div class="hero-wrap">
  <div class="hero-bg" data-parallax="0.35"><NetworkBackdrop class="hero-net" /></div>

  <header class="hero container">
    <div class="bar">
      <a class="wordmark" href="/">Daniel Uwandu</a>
      <nav class="nav" aria-label="Primary">
        <a href="#work">Work</a>
        <a href="#about">About</a>
        <a href="/resume.pdf" download="Daniel-Uwandu-CV.pdf">Download CV</a>
        <a class="pill pill--primary" href={`mailto:${email}`}>Email me</a>
      </nav>
      <ThemeToggle />
    </div>

    <div class="body" data-hero>
      <div class="top">
        <h1 class="name" aria-label="Daniel Uwandu">
          <span class="line" aria-hidden="true">{first.map((c, i) => <span class="ch" style={`--i: ${i}`}>{c}</span>)}</span>
          <span class="line" aria-hidden="true">{last.map((c, i) => <span class="ch" style={`--i: ${i + 3}`}>{c}</span>)}</span>
        </h1>
        <div class="photo-frame">
        <Image
          class="photo"
          src={photo}
          alt="Daniel Uwandu"
          widths={[240, 360, 480, 720]}
          sizes="(min-width: 900px) 300px, 40vw"
          loading="eager"
        />
        </div>
      </div>

      <div class="meta">
        <p class="lede">
          Software developer based in Lagos, Nigeria. I work in C#, TypeScript,
          JavaScript, Go, C++, SQL and Solidity, building on ASP.NET Core and
          NestJS with SQL Server and PostgreSQL.
        </p>

        <dl class="facts">
          <dt>Now</dt>
          <dd>Software developer at Today’s Solution</dd>
          <dt>Studied</dt>
          <dd>Computer Engineering, University of Lagos</dd>
          <dt>Available</dt>
          <dd>Open to roles, remote first. Can start now.</dd>
          <dt>Elsewhere</dt>
          <dd class="links">
            <a href="https://github.com/Idhaniel">GitHub</a>
            <a href="https://linkedin.com/in/daniel-u-b79b78194">LinkedIn</a>
          </dd>
        </dl>
      </div>
    </div>
  </header>
</div>

<style>
  .hero-wrap {
    position: relative;
    overflow: hidden;
  }
  /* The map sits behind everything, strongest top right, gone by the bottom. */
  .hero-bg { position: absolute; inset: 0; }
  .hero-wrap :global(.hero-net) {
    -webkit-mask-image: radial-gradient(120% 90% at 85% 20%, black 20%, transparent 75%);
    mask-image: radial-gradient(120% 90% at 85% 20%, black 20%, transparent 75%);
  }

  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
  }

  /* Top bar */
  .bar {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 24px;
    padding-block: 16px;
    border-bottom: 1px solid var(--rule);
  }
  .wordmark {
    font-size: 16px;
    font-weight: 500;
    letter-spacing: -0.01em;
    min-height: var(--target);
    display: inline-flex;
    align-items: center;
  }
  .nav {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 4px 28px;
    font-size: var(--text-small);
  }
  .nav a:not(.pill) {
    min-height: var(--target);
    display: inline-flex;
    align-items: center;
  }

  /* Name, photo, meta */
  .body {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 36px;
    padding-top: 48px;
    padding-bottom: clamp(40px, 6vw, 64px);
  }
  .top {
    display: flex;
    flex-direction: column-reverse;
    align-items: flex-start;
    gap: 32px;
  }
  .name {
    margin: 0;
    font-size: var(--text-display);
    line-height: var(--lh-display);
    letter-spacing: var(--track-display);
    font-weight: 400;
  }
  .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
    margin-bottom: -0.06em;
  }
  .ch { display: inline-block; }

  .photo-frame {
    width: min(42vw, 180px);
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius-panel);
  }
  .photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.3) contrast(1.03);
  }

  .meta {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: 32px;
    padding-top: 28px;
    border-top: 1px solid var(--rule-strong);
  }
  .lede {
    grid-column: 1 / -1;
    margin: 0;
    max-width: 34ch;
    font-size: var(--text-lede);
    line-height: var(--lh-lede);
    letter-spacing: var(--track-lede);
    color: var(--stone);
  }
  .facts {
    grid-column: 1 / -1;
    margin: 0;
    display: grid;
    grid-template-columns: 88px 1fr;
    row-gap: 10px;
    column-gap: 16px;
    font-size: var(--text-small);
    line-height: 1.4;
  }
  .facts dt { color: var(--ash); }
  .facts dd { margin: 0; }
  .links { display: flex; flex-wrap: wrap; gap: 4px 24px; }
  .links a { border-bottom: 1px solid var(--edge); }
  .links a:hover { border-color: var(--accent-ink); }

  /* Phones and tablets: everything centred, name above the nav. */
  @media (max-width: 899px) {
    .bar { flex-direction: column; justify-content: center; gap: 4px; }
    .bar > :global(.theme-toggle) { position: absolute; top: 16px; right: 0; }
    .nav { margin-left: 0; justify-content: center; flex-wrap: wrap; gap: 4px 24px; }
    .top { align-items: center; }
    .name { text-align: center; }
    .meta { text-align: center; }
    .lede { margin-inline: auto; }
    .facts {
      grid-template-columns: 88px minmax(0, 250px);
      justify-content: center;
      text-align: left;
    }
  }
  @media (max-width: 719px) {
    .nav { width: 100%; justify-content: space-between; gap: 4px 12px; }
    .nav .pill { padding: 0 18px; }
  }

  @media (min-width: 900px) {
    .top {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }
    .photo-frame { width: clamp(220px, 21vw, 300px); }
    .lede { grid-column: 1 / span 6; }
    .facts { grid-column: 8 / span 5; grid-template-columns: 104px 1fr; row-gap: 12px; }
  }

  /* The one page-load moment: name rises line by line, then the rest fades in. */
  @media (prefers-reduced-motion: no-preference) {
    .ch {
      transform: translateY(110%) rotate(8deg);
      transform-origin: 0 100%;
      animation: rise 700ms var(--ease) forwards;
      animation-delay: calc(var(--i) * 35ms);
    }
    .photo-frame {
      clip-path: inset(100% 0 0 0 round var(--radius-panel));
      animation: wipe 1100ms var(--ease) 350ms forwards;
    }
    .photo {
      transform: scale(1.2);
      animation: settle 1400ms var(--ease) 350ms forwards;
    }
    .bar, .meta {
      opacity: 0;
      animation: fade 900ms var(--ease) 700ms forwards;
    }
    .hero-bg {
      opacity: 0;
      animation: fade 1600ms var(--ease) 200ms forwards;
    }
  }
  @keyframes rise { to { transform: none; } }
  @keyframes wipe { to { clip-path: inset(0 0 0 0 round var(--radius-panel)); } }
  @keyframes settle { to { transform: none; } }
  @keyframes fade { to { opacity: 1; } }
</style>
